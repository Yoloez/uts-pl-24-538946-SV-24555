# Konfigurasi Aplikasi Laravel
APP_NAME="Kost Management"
APP_ENV=production
APP_KEY=base64:9U1mE1Qe1u2S8d4F7g3H0j5K6l7Z8x9C0v1B2n3M4=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Kredensial Basis Data MySQL (Dibaca oleh service database dan backend)
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=kost_db
DB_USERNAME=kost_user
DB_PASSWORD=kost_password_rahasia123
